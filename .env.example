# Veritabanı
DATABASE_URL=

# Avcı v2 canlı kaynak bağlayıcısı varsayılan olarak false kalmalıdır.
AVCI_LIVE_PROVIDER_ENABLED=false
# Platforma verilen Sahibinden iznini tenant kayıtlarına istek anında güvenli
# biçimde materialize eder. Referans zorunludur; bitiş boşsa süre sınırsızdır.
AVCI_SAHIBINDEN_PLATFORM_AUTHORIZATION_ENABLED=false
AVCI_SAHIBINDEN_PLATFORM_AUTHORIZATION_REFERENCE=
AVCI_SAHIBINDEN_PLATFORM_AUTHORIZATION_STARTS_AT=
AVCI_SAHIBINDEN_PLATFORM_AUTHORIZATION_EXPIRES_AT=
AVCI_CRAWLER_DELAY_SECS=13
AVCI_CRAWLER_MAX_REQUESTS_PER_MINUTE=5
AVCI_CRAWLER_MAX_LISTINGS_PER_JOB=11
# Canlı Actor için lisanslı Türkiye çıkışlı proxy zorunludur.
# Gerçek proxy parolası Apify tarafından secret olarak sağlanır.
AVCI_APIFY_PROXY_ENABLED=false
AVCI_APIFY_PROXY_REQUIRED=true
AVCI_APIFY_PROXY_GROUPS=RESIDENTIAL
AVCI_APIFY_PROXY_COUNTRY_CODE=TR
AVCI_WORKER_POLL_MS=5000
AVCI_WORKER_STALE_MS=300000
AVCI_WORKER_DISPATCH_MODE=
AVCI_RUN_ONCE=false
AVCI_WORKER_API_URL=
# En az 32 karakter; yalniz Vercel secret store'da tutulur ve Actor'a verilmez.
AVCI_WORKER_SIGNING_SECRET=
AVCI_MEDIA_MAX_BYTES=12582912
AVCI_CONTACT_RETENTION_DAYS=90

# İsteğe bağlı Apify tek-seferlik worker tetikleyicisi. Token yalnız Vercel
# secret store'da tutulur; istemciye ve URL query parametresine yazılmaz.
APIFY_AVCI_ACTOR_ID=
APIFY_TOKEN=

# Chrome eklentisinin izinli origin değerleri, virgülle ayrılır.
HUNTING_EXTENSION_ALLOWED_ORIGINS=

# Telefon şifreleme/HMAC anahtarları. Gerçek değerleri yalnız secret store'da tutun.
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY=
HUNTING_CONTACT_ENCRYPTION_KEY=
HUNTING_CONTACT_HMAC_KEY=

# ContactProvider credential adları. Canlı credential yoksa adapter kapalıdır.
HUNTING_PARTNER_FEED_TOKEN=
HUNTING_BANA_EMLAKCI_BUL_TOKEN=
HUNTING_FIRST_PARTY_SIGNING_SECRET=
HUNTING_CRM_PROVIDER_SECRET=

# Stüdyo fotoğraf/video çıktıları için private Vercel Blob. AI Sinematik Video
# tamamlandığında sağlayıcı çıktısı bu depoya kopyalanır; token yalnız sunucudadır.
BLOB_READ_WRITE_TOKEN=

# Platform tarafından yönetilen BytePlus ModelArk / Seedance 2.0. Bu değerler
# müşteriye veya tarayıcı bundle'ına gönderilmez. Anahtar yoksa hızlı Remotion
# video çalışır, ücretli sinematik video ise fail-closed kalır.
BYTEPLUS_ARK_API_KEY=
BYTEPLUS_SEEDANCE_MODEL=dreamina-seedance-2-0-260128
BYTEPLUS_ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# AI Portföy Video Stüdyosu. Anahtar yalnız server-side route tarafından okunur;
# NEXT_PUBLIC_ öneki kullanmayın ve anahtarı tarayıcıya/loglara göndermeyin.
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_PRIMARY_MODEL=poolside/laguna-s-2.1:free
OPENROUTER_VIDEO_FIXER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_VIDEO_PAID_FALLBACK_MODEL=qwen/qwen3-coder-next

# Müşteri web sitesi entegrasyonu. Anahtar en az 32 rastgele karakter olmalıdır.
# Üretim uygulamasının dışarıdan erişilen kök adresini yazın (sonunda / olmadan).
WEBSITE_API_KEY_SECRET=
NEXT_PUBLIC_APP_URL=

# Global Partner Ağı. Değerleri yalnız Vercel/secret store'da tutun.
PARTNER_CREDENTIAL_ENCRYPTION_KEY=
PARTNER_FEED_SIGNING_SECRET=
PARTNER_PUBLIC_COMPANY_SLUG=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# En az 32 rastgele karakter kullanın. Vercel Cron veya haricî zamanlayıcı
# aşağıdaki operasyon route'larına `Authorization: Bearer <CRON_SECRET>` yollar.
# Dakikalık zamanlama için Vercel Pro/Enterprise gerekir; Hobby yalnız günde bir
# cron çalıştırır ve dakikalık vercel.json ifadeleriyle deployment başarısız olur.
CRON_SECRET=
