{
  "manifest_version": 3,
  "name": "Business CEO AI Avcı",
  "version": "2.1.0",
  "description": "Açık filtreli arama URL'sini ve yalnızca görünür ilan satırlarını Avcı iş kuyruğuna aktarır.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.sahibinden.com/*",
    "https://jpp-ufeb.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bu aramayı Avcı'ya aktar"
  }
}
