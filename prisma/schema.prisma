model HuntedListing {
  id                       String                   @id @default(cuid())
  companyAccountId         String?
  companyAccount           CompanyAccount?          @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  huntJobId                String?
  huntJob                  HuntJob?                 @relation(fields: [huntJobId], references: [id], onDelete: SetNull)
  sourceProvider           SourceProvider?
  sourceListingId          String?
  sourceUrl                String                   @db.Text
  title                    String
  price                    String?
  location                 String?
  roomCount                String?
  area                     String?
  ownerName                String?
  ownerPhone               String?
  ownerPhoneNormalized     String?
  imageUrl                 String?
  rawData                  String?                  @db.Text
  descriptionText          String?                  @db.Text
  sanitizedDescriptionHtml String?                  @db.Text
  category                 String?
  subcategory              String?
  sellerType               String?
  listingPublishedAt       DateTime?
  priceAmount              Decimal?                 @db.Decimal(18, 2)
  currency                 String?
  province                 String?
  district                 String?
  neighborhood             String?
  street                   String?
  latitude                 Decimal?                 @db.Decimal(10, 7)
  longitude                Decimal?                 @db.Decimal(10, 7)
  addressPrecision         AddressPrecision         @default(UNKNOWN)
  acquisitionStatus        HuntingAcquisitionStatus @default(DISCOVERED)
  completenessScore        Int                      @default(0)
  attributesJson           Json?
  firstSeenAt              DateTime                 @default(now())
  lastSeenAt               DateTime                 @default(now())
  removedAt                DateTime?
  sourceUpdatedAt          DateTime?
  status                   HuntingStatus            @default(YELLOW)
  whatsappStatus           String                   @default("BEKLIYOR")
  notes                    String?                  @db.Text
  syncedToSite             Boolean                  @default(false)
  syncedProjectId          String?
  authorizationNote        String?                  @db.Text
  authorizedAt             DateTime?
  eliminationReason        String?
  eliminationNote          String?                  @db.Text
  eliminationSummary       String?                  @db.Text
  eliminatedAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  messages          HuntingMessage[]
  adCopies          AdCopy[]
  portfolioImport   PortfolioImportItem?
