  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, createdAt])
  @@index([propertyId, createdAt])
  @@index([status, expiresAt])
}

model StudioBatchItem {
  id                 String                @id @default(cuid())
  batchId            String
  batch              StudioBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceMediaId      String?
  sourceMedia        CrmPropertyMedia?     @relation("StudioSourceMedia", fields: [sourceMediaId], references: [id], onDelete: SetNull)
