  sourceBatchItems   StudioBatchItem[] @relation("StudioSourceMedia")
  attachedBatchItems StudioBatchItem[] @relation("StudioAttachedMedia")

  @@unique([companyAccountId, propertyId, fingerprint])
  @@index([companyAccountId, propertyId, archivedAt, sortOrder])
  @@index([propertyId, isCover, archivedAt])
  @@index([parentMediaId])
}

model StudioBatch {
