generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AGENT
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(USER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  favorites    Favorite[]
  appointments Appointment[]
  leads        Lead[]
}

model Project {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  location         String
  status           String // e.g., "Satışta", "Yapım Aşamasında", "Tamamlandı"
  image            String // Kapak görseli
  shortDescription String
  description      String   @db.Text
  features         String[] // Sosyal donatılar vb. array olarak
  deliveryDate     String
  price            String
  progress         Int      @default(0) // % inşaat durumu
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  units     Unit[]
  favorites Favorite[]
}

model Unit {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // e.g., "1+1", "2+1"
  area      String // e.g., "55m² - 65m²"
  price     String? // nullable if not specified
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  icon             String
  details          String   @db.Text
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  excerpt   String
  content   String   @db.Text
  image     String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  userId    String? // If created by an agent
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum MessageDeliveryStatus {
  NOT_APPLICABLE
  RECEIVED
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model Appointment {
  id        String            @id @default(cuid())
  userId    String?
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String
  date      DateTime
  status    AppointmentStatus @default(PENDING)
  notes     String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  verified  Boolean  @default(false)
  token     String? // Verification token
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model AgentApplication {
  id        String            @id @default(cuid())
  company   String
  name      String
  email     String
  phone     String
  region    String
  status    ApplicationStatus @default(PENDING)
  notes     String?           @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// ============================================================
// YZ FABRİKASI MODÜLLERİ
// ============================================================

// --- Enums ---

enum HuntingStatus {
  YELLOW // Pazarlıkta
  AUTHORIZED // Satış yetkisi alındı, portföy onayı bekliyor
  RED // Elendi
  GREEN // Avlandı - siteye eklenmek üzere
}

enum AdPlatform {
  GOOGLE_ADS
  INSTAGRAM
  WHATSAPP
}

enum CustomerIntent {
  INVESTMENT // Yatırımlık
  RESIDENTIAL // Oturmalık
  BOTH
  UNKNOWN
}

enum ConversationChannel {
  WHATSAPP
  EMAIL
  WEB_CHAT
}

enum NotificationType {
  APPOINTMENT_REQUEST
  NEW_CUSTOMER_MESSAGE
  GREEN_LISTING
  WEBSITE_GENERATED
  AD_COPY_READY
  STUDIO_READY
  SYSTEM
}

enum CompanyAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
}

enum AiProvider {
  OPENAI
  GEMINI
  OPENROUTER
}

enum CompanyMemberRole {
  OWNER
  MANAGER
  AGENT
  VIEWER
}

enum CrmContactType {
  BUYER
  SELLER
  INVESTOR
  TENANT
  OTHER
}

enum CrmContactStage {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  OFFER
  WON
  LOST
}

enum ConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum CrmPropertyStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

enum CrmDealStage {
  NEW
  CONTACTED
  QUALIFIED
  MATCHED
  VIEWING
  OFFER
  CONTRACT
  WON
  LOST
}

enum CrmTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CrmTaskType {
  CALL
  MESSAGE
  MEETING
  VIEWING
  FOLLOW_UP
  DOCUMENT
  OTHER
}

model CompanyAccount {
  id                   String               @id @default(cuid())
  companyName          String
  slug                 String               @unique
  ownerName            String
  ownerEmail           String?
  accessKeyLookup      String?              @unique
  accessKeyHash        String?
  accessKeyHint        String?
  verificationCodeHash String?
  verificationCodeHint String?
  status               CompanyAccountStatus @default(ACTIVE)
  subscriptionStatus   SubscriptionStatus   @default(TRIAL)
  subscriptionPlan     String               @default("standard")
  subscriptionEndsAt   DateTime?
  workspaceEnabled     Boolean              @default(false)
  sessionVersion       Int                  @default(1)
  lastLoginAt          DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  aiCredentials            CompanyAiCredential[]
  members                  CompanyMember[]
  crmContacts              CrmContact[]
  crmProperties            CrmProperty[]
  crmDeals                 CrmDeal[]
  crmTasks                 CrmTask[]
  crmMatches               CrmMatch[]
  crmActivities            CrmActivity[]
  notifications            Notification[]
  googleCalendarConnection GoogleCalendarConnection?
  calendarSyncLogs         CalendarSyncLog[]
  huntedListings           HuntedListing[]
  portfolioSources         PortfolioSource[]
  portfolioImports         PortfolioImportItem[]
  adCampaigns              AdCampaign[]
  websiteMarketingAnalyses MarketingWebsiteAnalysis[]
  generalManagerMessages   GeneralManagerMessage[]

  @@index([status, subscriptionStatus])
  @@index([createdAt])
}

model CompanyAiCredential {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider         AiProvider
  encryptedApiKey  String         @db.Text
  keyHint          String
  model            String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyAccountId, provider])
}

model CompanyMember {
  id                   String            @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount    @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String?
  role                 CompanyMemberRole @default(AGENT)
  active               Boolean           @default(true)
  username             String?           @unique
  passwordHash         String?
  sessionVersion       Int               @default(1)
  failedLoginAttempts  Int               @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  credentialsUpdatedAt DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  contacts      CrmContact[]
  properties    CrmProperty[]
  deals         CrmDeal[]
  tasks         CrmTask[]
  activities    CrmActivity[]
  notifications Notification[]

  @@unique([companyAccountId, email])
  @@index([companyAccountId, active])
}

model CrmContact {
  id                   String          @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  assignedMemberId     String?
  assignedMember       CompanyMember?  @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  name                 String
  phone                String?
  email                String?
  type                 CrmContactType  @default(BUYER)
  stage                CrmContactStage @default(NEW)
  source               String?
  desiredLocation      String?
  desiredRoomCount     String?
  budgetMin            Float?
  budgetMax            Float?
  notes                String?         @db.Text
  tags                 String[]        @default([])
  score                Int             @default(50)
  consentStatus        ConsentStatus   @default(UNKNOWN)
  consentUpdatedAt     DateTime?
  nextActionAt         DateTime?
  sourceConversationId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  ownedProperties CrmProperty[] @relation("PropertyOwner")
  deals           CrmDeal[]
  tasks           CrmTask[]
  matches         CrmMatch[]
  activities      CrmActivity[]

  @@unique([companyAccountId, sourceConversationId])
  @@index([companyAccountId, stage])
  @@index([companyAccountId, phone])
  @@index([assignedMemberId])
}

model CrmProperty {
  id                  String            @id @default(cuid())
  companyAccountId    String
  companyAccount      CompanyAccount    @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  ownerContactId      String?
  ownerContact        CrmContact?       @relation("PropertyOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  assignedMemberId    String?
  assignedMember      CompanyMember?    @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  title               String
  referenceCode       String?
  location            String?
  price               Float?
  roomCount           String?
  area                Float?
  status              CrmPropertyStatus @default(DRAFT)
  description         String?           @db.Text
  imageUrl            String?
  sourceListingId     String?
  sellerPortalToken   String            @unique @default(uuid())
  sellerPortalEnabled Boolean           @default(true)
  listingViews        Int               @default(0)
  inquiryCount        Int               @default(0)
  showingCount        Int               @default(0)
  offerCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  deals           CrmDeal[]
  tasks           CrmTask[]
  matches         CrmMatch[]
  activities      CrmActivity[]
  portfolioImport PortfolioImportItem?
  adCampaigns     AdCampaign[]

  @@unique([companyAccountId, sourceListingId])
  @@index([companyAccountId, status])
  @@index([ownerContactId])
  @@index([assignedMemberId])
}

model CrmDeal {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String
  contact          CrmContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         CrmProperty?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedMemberId String?
  assignedMember   CompanyMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  title            String
  stage            CrmDealStage   @default(NEW)
  estimatedValue   Float?
  commissionRate   Float?         @default(2)
  probability      Int            @default(20)
  nextAction       String?
  expectedCloseAt  DateTime?
  closedAt         DateTime?
  notes            String?        @db.Text
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tasks      CrmTask[]
  activities CrmActivity[]

  @@index([companyAccountId, stage])
  @@index([contactId])
  @@index([propertyId])
  @@index([assignedMemberId])
}

model CrmTask {
  id                 String         @id @default(cuid())
  companyAccountId   String
  companyAccount     CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId          String?
  contact            CrmContact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId         String?
  property           CrmProperty?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId             String?
  deal               CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignedMemberId   String?
  assignedMember     CompanyMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  type               CrmTaskType    @default(FOLLOW_UP)
  title              String
  description        String?        @db.Text
  dueAt              DateTime?
  endAt              DateTime?
  allDay             Boolean        @default(false)
  priority           Int            @default(2)
  status             CrmTaskStatus  @default(OPEN)
  completedAt        DateTime?
  calendarSource     String         @default("JASMINE")
  calendarSyncStatus String         @default("LOCAL")
  googleCalendarId   String?
  googleEventId      String?
  googleUpdatedAt    DateTime?
  calendarSyncedAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@unique([companyAccountId, googleCalendarId, googleEventId])
  @@index([companyAccountId, status, dueAt])
  @@index([assignedMemberId])
}

model GoogleCalendarConnection {
  id                    String         @id @default(cuid())
  companyAccountId      String         @unique
  companyAccount        CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  connectedByMemberId   String?
  email                 String?
  calendarId            String         @default("primary")
  encryptedAccessToken  String         @db.Text
  encryptedRefreshToken String         @db.Text
  accessTokenExpiresAt  DateTime?
  scope                 String?
  syncToken             String?        @db.Text
  lastSyncedAt          DateTime?
  lastSyncStatus        String         @default("CONNECTED")
  lastSyncError         String?        @db.Text
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([companyAccountId, lastSyncStatus])
}

model CalendarSyncLog {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  direction        String         @default("TWO_WAY")
  status           String
  pulledCount      Int            @default(0)
  pushedCount      Int            @default(0)
  conflictCount    Int            @default(0)
  errorMessage     String?        @db.Text
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  @@index([companyAccountId, startedAt])
}

model CrmMatch {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String
  contact          CrmContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String
  property         CrmProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score            Int
  reasons          String[]       @default([])
  status           String         @default("NEW")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyAccountId, contactId, propertyId])
  @@index([companyAccountId, score])
}

model CrmActivity {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          CrmContact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         CrmProperty?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId           String?
  deal             CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorMemberId    String?
  actorMember      CompanyMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  type             String
  title            String
  description      String?        @db.Text
  metadata         String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([companyAccountId, createdAt])
  @@index([contactId])
  @@index([propertyId])
  @@index([dealId])
}

model PlatformAdminLoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

// --- Modül 2: Avcı / Portföy Toplayıcı ---

model CompanyProfile {
  id              String   @id @default(cuid())
  companyName     String
  strengths       String[] // Şirketin güçlü yanları
  uniquePoints    String[] // Benzersiz satış noktaları (USP)
  targetAudience  String?  @db.Text
  serviceAreas    String[] // Hizmet bölgeleri
  yearsInBusiness Int?
  teamSize        Int?
  extraNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HuntedListing {
  id                 String          @id @default(cuid())
  companyAccountId   String?
  companyAccount     CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  sourceUrl          String // Sahibinden.com link
  title              String
  price              String?
  location           String?
  roomCount          String? // e.g. "3+1"
  area               String? // e.g. "120 m²"
  ownerName          String?
  ownerPhone         String?
  imageUrl           String?
  rawData            String?         @db.Text // JSON olarak ham veri
  status             HuntingStatus   @default(YELLOW)
  whatsappStatus     String          @default("BEKLIYOR") // BEKLIYOR, GONDERILDI, CEVAPLANDI
  notes              String?         @db.Text
  syncedToSite       Boolean         @default(false) // Modül 1'e gönderildi mi?
  syncedProjectId    String? // Bağlanan Project id
  authorizationNote  String?         @db.Text
  authorizedAt       DateTime?
  eliminationReason  String?
  eliminationNote    String?         @db.Text
  eliminationSummary String?         @db.Text
  eliminatedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  messages        HuntingMessage[]
  adCopies        AdCopy[]
  portfolioImport PortfolioImportItem?

  @@unique([companyAccountId, sourceUrl])
  @@index([companyAccountId, status, updatedAt])
}

model PortfolioSource {
  id                  String         @id @default(cuid())
  companyAccountId    String
  companyAccount      CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  name                String
  type                String
  baseUrl             String?
  feedPath            String?
  encryptedCredential String?        @db.Text
  credentialHint      String?
  active              Boolean        @default(true)
  lastSyncStatus      String         @default("READY")
  lastSyncError       String?        @db.Text
  lastSyncedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  imports PortfolioImportItem[]

  @@index([companyAccountId, active])
  @@index([companyAccountId, lastSyncStatus])
}

model PortfolioImportItem {
  id               String           @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount   @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           PortfolioSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  huntedListingId  String?          @unique
  huntedListing    HuntedListing?   @relation(fields: [huntedListingId], references: [id], onDelete: SetNull)
  propertyId       String?          @unique
  property         CrmProperty?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  externalId       String?
  fingerprint      String
  sourceUrl        String?
  title            String
  location         String?
  price            Float?
  roomCount        String?
  area             Float?
  description      String?          @db.Text
  imageUrl         String?
  rawPayload       String?          @db.Text
  status           String           @default("PENDING")
  reviewNote       String?          @db.Text
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyAccountId, fingerprint])
  @@index([companyAccountId, status, createdAt])
  @@index([sourceId, status])
}

model WhatsAppMessage {
  id        String   @id @default(cuid())
  phone     String
  fromMe    Boolean
  content   String   @db.Text
  status    String   @default("SENT") // SENT, DRAFT
  createdAt DateTime @default(now())
}

model HuntingMessage {
  id        String        @id @default(cuid())
  listingId String
  listing   HuntedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  content   String        @db.Text // Üretilen ikna mesajı
  tone      String? // e.g. "resmi", "samimi", "acil"
  sent      Boolean       @default(false) // WhatsApp'tan gönderildi mi?
  createdAt DateTime      @default(now())
}

// --- Modül 1: Yazılımcı / Entegratör ---

model WebsiteTemplate {
  id          String   @id @default(cuid())
  name        String
  description String
  thumbnail   String // Önizleme görseli yolu
  category    String // e.g. "modern", "klasik", "minimal"
  htmlPath    String // Şablon dosya yolu
  createdAt   DateTime @default(now())

  generatedSites GeneratedWebsite[]
}

model GeneratedWebsite {
  id           String           @id @default(cuid())
  templateId   String?
  template     WebsiteTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  companyName  String
  logoUrl      String?
  primaryColor String           @default("#1a365d")
  accentColor  String           @default("#c6a55a")
  phone        String?
  email        String?
  address      String?
  zipFilePath  String? // Üretilen .zip dosya yolu
  status       String           @default("pending") // pending, generating, ready, error
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

// --- Modül 3: Pazarlamacı / Reklam Ekibi ---

model AdCampaign {
  id               String          @id @default(cuid())
  companyAccountId String?
  companyAccount   CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         CrmProperty?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name             String
  description      String?         @db.Text
  type             String // "listing" veya "brand"
  objective        String?
  audience         String?
  tone             String?
  status           String          @default("DRAFT")
  posterTemplate   String?
  posterHeadline   String?
  posterSubline    String?
  posterCta        String?
  generatedBy      String?
  generatedModel   String?
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  adCopies AdCopy[]

  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, type])
  @@index([propertyId])
}

model AdCopy {
  id           String         @id @default(cuid())
  campaignId   String?
  campaign     AdCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  listingId    String?
  listing      HuntedListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  platform     AdPlatform
  headline     String
  body         String         @db.Text
  callToAction String?
  targetUrl    String? // İlan veya ana sayfa linki
  approved     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MarketingWebsiteAnalysis {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteUrl       String
  domain           String
  status           String         @default("READY")
  summary          String         @db.Text
  strengths        String         @db.Text
  opportunities    String         @db.Text
  channelPlan      String         @db.Text
  firstActions     String         @db.Text
  generatedBy      String
  generatedModel   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([companyAccountId, createdAt])
}

// --- Modül 4: Asistan / CRM ---

model CustomerConversation {
  id                    String              @id @default(cuid())
  customerName          String
  customerPhone         String?
  customerEmail         String?
  channel               ConversationChannel @default(WEB_CHAT)
  intent                CustomerIntent      @default(UNKNOWN)
  summary               String?             @db.Text // AI tarafından üretilen özet
  notes                 String?             @db.Text
  tags                  String[]            @default([])
  aiEnabled             Boolean             @default(true)
  lastCustomerMessageAt DateTime?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  messages            ConversationMessage[]
  appointmentRequests AppointmentRequest[]
}

model ConversationMessage {
  id                String                @id @default(cuid())
  conversationId    String
  conversation      CustomerConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // "customer", "assistant", "patron"
  content           String                @db.Text
  metadata          String?               @db.Text // JSON: çapraz satış önerileri vb.
  providerMessageId String?               @unique
  deliveryStatus    MessageDeliveryStatus @default(NOT_APPLICABLE)
  messageType       String                @default("TEXT")
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?               @db.Text
  createdAt         DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
}

model AppointmentRequest {
  id             String               @id @default(cuid())
  conversationId String
  conversation   CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerName   String
  customerPhone  String?
  proposedDate   DateTime?
  proposedTime   String? // e.g. "14:00"
  status         AppointmentStatus    @default(PENDING)
  patronNote     String?              @db.Text
  confirmMessage String?              @db.Text // AI'ın ürettiği teyit mesajı
  reminderSentAt DateTime?
  rescheduledAt  DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status, proposedDate])
}

// --- Ortak: Bildirim Sistemi ---

model Notification {
  id                String           @id @default(cuid())
  companyAccountId  String?
  companyAccount    CompanyAccount?  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  recipientMemberId String?
  recipientMember   CompanyMember?   @relation(fields: [recipientMemberId], references: [id], onDelete: Cascade)
  recipientKey      String?
  type              NotificationType
  title             String
  message           String           @db.Text
  link              String? // İlgili sayfaya yönlendirme linki
  important         Boolean          @default(false)
  read              Boolean          @default(false)
  dedupeKey         String?
  metadata          String?          @db.Text // JSON: ek bilgiler
  createdAt         DateTime         @default(now())

  @@unique([companyAccountId, recipientKey, dedupeKey])
  @@index([companyAccountId, recipientKey, important, read, createdAt])
}

// --- Modül 5: Dijital Fotoğraf Stüdyosu ---

model PhotoShoot {
  id             String   @id @default(cuid())
  device         String // e.g. "iPhone 15 Pro", "Samsung S Serisi"
  uploadedCount  Int      @default(0)
  uploadedPhotos String?  @db.Text // JSON: yüklenen orijinal fotoğrafların yolları
  status         String   @default("pending") // pending, processing, ready, error
  logoUrl        String?  @db.Text // Yüklenen PNG logo
  websiteUrl     String? // Eklenmek istenen web sitesi adresi
  textColor      String?  @default("#ffffff") // Web sitesi ve filigran yazı rengi
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packages ProcessedPackage[]
}

model ProcessedPackage {
  id                String     @id @default(cuid())
  shootId           String
  shoot             PhotoShoot @relation(fields: [shootId], references: [id], onDelete: Cascade)
  filterName        String // e.g. "Ferah Gün Işığı"
  zipUrl            String // Orijinal Profesyonel HDR ZIP linki
  watermarkedZipUrl String? // Logo ve Web sitesi filigranlı ZIP linki
  createdAt         DateTime   @default(now())
}

// --- Komuta Merkezi (Genel Müdür Asistanı) ---

model GeneralManagerMessage {
  id               String          @id @default(cuid())
  companyAccountId String?
  companyAccount   CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  authorId         String?
  authorName       String?
  authorType       String?
  role             String // "patron", "asistan", "system"
  content          String          @db.Text
  provider         String?
  createdAt        DateTime        @default(now())

  @@index([companyAccountId, createdAt])
}

model WhatsAppConfig {
  id                   String   @id @default("default")
  token                String?  @db.Text
  phoneNumberId        String?
  businessAccountId    String?
  verifyToken          String   @default("configure-in-environment")
  geminiApiKey         String?  @db.Text
  companyName          String?  @default("Jasmine Group")
  assistantName        String?  @default("Efe")
  serviceCity          String?  @default("Alanya")
  companyAddress       String?  @db.Text
  companyDetails       String?  @db.Text
  websiteUrl           String?  @db.Text
  instagramUrl         String?  @db.Text
  languages            String?  @db.Text
  fallbackTemplateName String?
  templateLanguage     String?  @default("tr")
  updatedAt            DateTime @updatedAt
}
