model ManagerPolicy {
  id               String              @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  scope            ManagerPolicyScope
  status           ManagerPolicyStatus @default(ACTIVE)
  ruleType         String
  rulePayload      Json
  conversationId   String?
  sourceMessageId  String?
  sourceActionId   String?
  createdByType    String
  createdById      String?
  effectiveFrom    DateTime            @default(now())
  expiresAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([companyAccountId, status, effectiveFrom, expiresAt])
  @@index([companyAccountId, conversationId, status])
}

model ManagerAuditLog {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  operationEventId String?
  operationEvent   OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId  String?
  managerAction    GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  actorType        String
  actorId          String?
  operation        String
  entityType       String?
  entityId         String?
  verifiedContext  Json?
  evidence         Json?
  structuredAi     Json?
  confidence       Float?
  policyDecision   String?
  result           String
  errorCode        String?
  errorMessage     String?               @db.Text
  correctionOfId   String?
  correctionOf     ManagerAuditLog?      @relation("AuditCorrections", fields: [correctionOfId], references: [id], onDelete: SetNull)
  corrections      ManagerAuditLog[]     @relation("AuditCorrections")
  createdAt        DateTime              @default(now())
  completedAt      DateTime?

  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, entityType, entityId])
  @@index([operationEventId])
  @@index([managerActionId])
}

model IdentityLink {
