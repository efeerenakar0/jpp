model WhatsAppOutboxMessage {
  id                       String                @id @default(cuid())
  companyAccountId         String
  companyAccount           CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  conversationId           String?
  listingId                String?
  contactId                String?
  huntedContactId          String?
  huntedContact            HuntedContact?        @relation(fields: [huntedContactId], references: [id], onDelete: SetNull)
  propertyId               String?
  toPhone                  String
  content                  String                @db.Text
  provider                 String
  status                   String                @default("QUEUED")
  idempotencyKey           String
  providerMessageId        String?               @unique
  recipientType            WhatsAppRecipientType @default(UNKNOWN)
  recipientId              String?
  purpose                  String?
  relatedTaskId            String?
  operationEventId         String?
  operationEvent           OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId          String?
  managerAction            GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  correlationId            String?
  replyToProviderMessageId String?
  metadata                 Json?
  createdByType            String?
  createdById              String?
  attemptCount             Int                   @default(0)
  maxAttempts              Int                   @default(5)
  nextAttemptAt            DateTime              @default(now())
  lockedAt                 DateTime?
  sentAt                   DateTime?
  deliveredAt              DateTime?
  failedAt                 DateTime?
  lastError                String?               @db.Text
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  deliveryAudits MessageDeliveryAudit[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, toPhone, createdAt])
  @@index([companyAccountId, recipientType, recipientId])
  @@index([companyAccountId, huntedContactId, createdAt])
  @@index([operationEventId])
  @@index([managerActionId])
}

// --- Dijital Genel Müdür: olay, aksiyon, kanıt ve gözlemlenebilirlik ---

model OperationEvent {
  id               String             @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount     @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  eventType        OperationEventType
  entityType       String?
  entityId         String?
  actorType        String?
  actorId          String?
  contactId        String?
  propertyId       String?
  listingId        String?
  taskId           String?
  conversationId   String?
  sourceProvider   String?
  sourceMessageId  String?
  metadata         Json?
  occurredAt       DateTime           @default(now())
  idempotencyKey   String
  createdAt        DateTime           @default(now())

  actions         GeneralManagerAction[]
  outboxMessages  WhatsAppOutboxMessage[]
  commitments     OperationalCommitment[]
  taskTransitions TaskStatusTransition[]
  auditLogs       ManagerAuditLog[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, eventType, occurredAt])
  @@index([companyAccountId, entityType, entityId])
  @@index([companyAccountId, sourceMessageId])
}

model GeneralManagerAction {
  id                    String                     @id @default(cuid())
  companyAccountId      String
  companyAccount        CompanyAccount             @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  operationEventId      String?
  operationEvent        OperationEvent?            @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  triggerMessageId      String?
  taskId                String?
  actionType            GeneralManagerActionType
  targetType            String?
  targetId              String?
  reason                String                     @db.Text
  evidence              Json?
  confidence            Float
  riskLevel             ManagerRiskLevel
  requiresApproval      Boolean                    @default(true)
  policyDecision        String
  payload               Json?
  proposedMessage       String?                    @db.Text
  status                GeneralManagerActionStatus @default(PROPOSED)
  idempotencyKey        String
  provider              String?
  model                 String?
  requestedByType       String?
  requestedById         String?
  errorCode             String?
  errorMessage          String?                    @db.Text
  approvedAt            DateTime?
  executionStartedAt    DateTime?
  executionAttemptCount Int                        @default(0)
  executedAt            DateTime?
  failedAt              DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  approval        ActionApproval?
  outboxMessages  WhatsAppOutboxMessage[]
  commitments     OperationalCommitment[]
  taskTransitions TaskStatusTransition[]
  handoffs        ConversationHandoff[]
  auditLogs       ManagerAuditLog[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, createdAt])
  @@index([companyAccountId, actionType, createdAt])
  @@index([operationEventId])
}

model ActionApproval {
  id               String                 @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount         @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  actionId         String                 @unique
  action           GeneralManagerAction   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  decision         ActionApprovalDecision @default(PENDING)
  decidedByType    String?
  decidedById      String?
  decisionReason   String?                @db.Text
  editedPayload    Json?
  decidedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([companyAccountId, decision, createdAt])
}

model TaskStatusTransition {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  taskId           String
  task             CrmTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus       OperationalTaskStatus
  toStatus         OperationalTaskStatus
  operationEventId String?
  operationEvent   OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId  String?
  managerAction    GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  sourceMessageId  String?
  actorType        String?
  actorId          String?
  evidence         Json?
  reason           String?               @db.Text
  idempotencyKey   String
  createdAt        DateTime              @default(now())

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, taskId, createdAt])
}

model OperationalCommitment {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  taskId           String?
  task             CrmTask?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  memberId         String?
  member           CompanyMember?        @relation(fields: [memberId], references: [id], onDelete: SetNull)
  contactId        String?
  propertyId       String?
  operationEventId String?
  operationEvent   OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId  String?
  managerAction    GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  description      String                @db.Text
  sourceMessageId  String?
  relativeTimeText String?
  dueAt            DateTime?
  timezone         String                @default("Europe/Istanbul")
  certainty        Float                 @default(0)
  status           CommitmentStatus      @default(OPEN)
  reminderCount    Int                   @default(0)
  lastReminderAt   DateTime?
  escalatedAt      DateTime?
  completedAt      DateTime?
  idempotencyKey   String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, dueAt])
  @@index([memberId, status])
}

model ConversationHandoff {
  id               String                    @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount            @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  conversationId   String
  conversation     CustomerConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  managerActionId  String?
  managerAction    GeneralManagerAction?     @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  requestedByType  String?
  requestedById    String?
  assignedMemberId String?
  status           ConversationHandoffStatus @default(PROPOSED)
  summary          String?                   @db.Text
  verifiedContext  Json?
  requestedAt      DateTime                  @default(now())
  acceptedAt       DateTime?
  returnedAt       DateTime?
  idempotencyKey   String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, createdAt])
  @@index([conversationId, status])
}

model MessageDeliveryAudit {
  id                String                @id @default(cuid())
  companyAccountId  String
  companyAccount    CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  outboxMessageId   String
  outboxMessage     WhatsAppOutboxMessage @relation(fields: [outboxMessageId], references: [id], onDelete: Cascade)
  status            DeliveryAuditStatus
  providerMessageId String?
  rawStatus         String?
  errorCode         String?
  errorMessage      String?               @db.Text
  metadata          Json?
  idempotencyKey    String
  occurredAt        DateTime              @default(now())
  createdAt         DateTime              @default(now())

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, occurredAt])
  @@index([outboxMessageId, occurredAt])
}

model WhatsAppDeliveryReceipt {
  id                String              @id @default(cuid())
  companyAccountId  String
  companyAccount    CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider          String
  providerMessageId String
  status            DeliveryAuditStatus
  rawStatus         String?
  errorCode         String?
  errorMessage      String?             @db.Text
  metadata          Json?
  idempotencyKey    String
  occurredAt        DateTime            @default(now())
  processedAt       DateTime?
  createdAt         DateTime            @default(now())

  @@unique([companyAccountId, idempotencyKey], map: "WaDeliveryReceipt_tenant_idempotency_key")
  @@index([companyAccountId, provider, providerMessageId, processedAt], map: "WaDeliveryReceipt_pending_idx")
}

model ManagerNotificationPreference {
