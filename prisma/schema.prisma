model CompanyAccount {
  id                           String                  @id @default(cuid())
  companyName                  String
  slug                         String                  @unique
  ownerName                    String
  ownerEmail                   String?
  ownerPhone                   String?
  ownerPhoneNormalized         String?
  ownerPhoneVerificationStatus PhoneVerificationStatus @default(UNVERIFIED)
  ownerPhoneVerifiedAt         DateTime?
  brandLogoData                String?                 @db.Text
  accessKeyLookup              String?                 @unique
  accessKeyHash                String?
  accessKeyHint                String?
  verificationCodeHash         String?
  verificationCodeHint         String?
  status                       CompanyAccountStatus    @default(ACTIVE)
  subscriptionStatus           SubscriptionStatus      @default(TRIAL)
  subscriptionPlan             String                  @default("standard")
  subscriptionEndsAt           DateTime?
  workspaceEnabled             Boolean                 @default(false)
  timezone                     String                  @default("Europe/Istanbul")
  onboardingState              Json?
  onboardingCompletedAt        DateTime?
  sessionVersion               Int                     @default(1)
  lastLoginAt                  DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt

  aiCredentials               CompanyAiCredential[]
  members                     CompanyMember[]
  crmContacts                 CrmContact[]
  crmProperties               CrmProperty[]
  crmDeals                    CrmDeal[]
  crmTasks                    CrmTask[]
  crmMatches                  CrmMatch[]
  crmActivities               CrmActivity[]
  notifications               Notification[]
  googleCalendarConnection    GoogleCalendarConnection?
  calendarSyncLogs            CalendarSyncLog[]
  huntedListings              HuntedListing[]
  portfolioSources            PortfolioSource[]
  portfolioImports            PortfolioImportItem[]
  adCampaigns                 AdCampaign[]
  websiteMarketingAnalyses    MarketingWebsiteAnalysis[]
  generalManagerMessages      GeneralManagerMessage[]
  phoneVerificationChallenges PhoneVerificationChallenge[]
  operationEvents             OperationEvent[]
  generalManagerActions       GeneralManagerAction[]
  actionApprovals             ActionApproval[]
  taskStatusTransitions       TaskStatusTransition[]
  operationalCommitments      OperationalCommitment[]
  conversationHandoffs        ConversationHandoff[]
  messageDeliveryAudits       MessageDeliveryAudit[]
  whatsAppDeliveryReceipts    WhatsAppDeliveryReceipt[]
  managerPreference           ManagerNotificationPreference?
  managerPolicies             ManagerPolicy[]
  auditLogs                   ManagerAuditLog[]
  identityLinks               IdentityLink[]
  dailyManagerSummaries       DailyManagerSummary[]
  whatsAppConfig              WhatsAppConfig?
  customerConversations       CustomerConversation[]
  whatsAppMessages            WhatsAppMessage[]
  whatsAppOutboxMessages      WhatsAppOutboxMessage[]
  documents                   CompanyDocument[]
  documentFavorites           DocumentFavorite[]
  documentAuditLogs           DocumentAuditLog[]
  sourceAuthorizations        SourceAuthorization[]
  huntJobs                    HuntJob[]
  huntedContacts              HuntedContact[]
  contactConsents             ContactConsent[]
  contactPolicyDecisions      ContactPolicyDecision[]
  huntedOutreachApprovals     HuntedOutreachApproval[]
  websiteIntegrations         WebsiteIntegration[]
  generatedWebsites           GeneratedWebsite[]
  websitePromptVersions       WebsitePromptVersion[]
  propertyMedia               CrmPropertyMedia[]
  studioBatches               StudioBatch[]

  @@index([status, subscriptionStatus])
  @@index([createdAt])
}

model DocumentTemplate {
  id                  String                    @id @default(cuid())
  key                 String
  name                String
  category            String
  description         String                    @db.Text
  estimatedMinutes    Int                       @default(5)
  version             Int                       @default(1)
  active              Boolean                   @default(true)
  lastReviewedAt      DateTime
  legalStatus         DocumentLegalReviewStatus @default(DRAFT)
  legalNotice         String                    @db.Text
  officialFormWarning String?                   @db.Text
  schema              Json
  content             Json
  sources             Json
  signatureRoles      Json
  tags                String[]                  @default([])
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  documents CompanyDocument[]

  @@unique([key, version])
  @@index([active, category])
  @@index([name])
}

model CompanyDocument {
  id               String                    @id @default(cuid())
  publicId         String                    @unique @default(uuid())
  companyAccountId String
  companyAccount   CompanyAccount            @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  templateId       String
  template         DocumentTemplate          @relation(fields: [templateId], references: [id], onDelete: Restrict)
  documentNumber   String
  title            String
  status           DocumentRecordStatus      @default(DRAFT)
  legalStatus      DocumentLegalReviewStatus @default(DRAFT)
  templateKey      String
  templateVersion  Int
  values           Json
  templateSnapshot Json
  renderedSnapshot Json?
  contextSnapshot  Json
  versionGroupId   String                    @default(uuid())
  versionNumber    Int                       @default(1)
  parentDocumentId String?
  parentDocument   CompanyDocument?          @relation("DocumentVersions", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childVersions    CompanyDocument[]         @relation("DocumentVersions")
  createdByType    String
  createdById      String
  createdByName    String
  lastEditedByType String
  lastEditedById   String
  lastEditedByName String
  generatedAt      DateTime?
  archivedAt       DateTime?
  cancelledAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  auditLogs DocumentAuditLog[]

  @@unique([companyAccountId, documentNumber])
  @@unique([companyAccountId, versionGroupId, versionNumber])
  @@index([companyAccountId, status, deletedAt, updatedAt])
  @@index([companyAccountId, templateKey, createdAt])
  @@index([parentDocumentId])
}

model DocumentFavorite {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  actorKey         String
  templateKey      String
  createdAt        DateTime       @default(now())

  @@unique([companyAccountId, actorKey, templateKey])
  @@index([companyAccountId, actorKey])
}

model DocumentAuditLog {
  id               String              @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  documentId       String?
  document         CompanyDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  action           DocumentAuditAction
  actorType        String
  actorId          String
  actorName        String
  metadata         Json?
  createdAt        DateTime            @default(now())

  @@index([companyAccountId, createdAt])
  @@index([documentId, createdAt])
}

model CompanyAiCredential {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider         AiProvider
  encryptedApiKey  String         @db.Text
  keyHint          String
  model            String?
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyAccountId, provider])
}

model CompanyMember {
  id                             String                  @id @default(cuid())
  companyAccountId               String
  companyAccount                 CompanyAccount          @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  name                           String
  email                          String?
  phone                          String?
  phoneNormalized                String?
  phoneVerificationStatus        PhoneVerificationStatus @default(UNVERIFIED)
  phoneVerifiedAt                DateTime?
  canReceiveWhatsAppTasks        Boolean                 @default(true)
  allowAutomaticInternalMessages Boolean                 @default(false)
  preferredLanguage              String                  @default("tr")
  workHours                      Json?
  availability                   MemberAvailability      @default(AVAILABLE)
  specialtyRegions               String[]                @default([])
  specialties                    String[]                @default([])
  maxActiveTaskCapacity          Int                     @default(10)
  lastAssignedAt                 DateTime?
  role                           CompanyMemberRole       @default(AGENT)
  active                         Boolean                 @default(true)
  username                       String?                 @unique
  passwordHash                   String?
  sessionVersion                 Int                     @default(1)
  failedLoginAttempts            Int                     @default(0)
  lockedUntil                    DateTime?
  lastLoginAt                    DateTime?
  credentialsUpdatedAt           DateTime?
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime                @updatedAt

  contacts      CrmContact[]
  properties    CrmProperty[]
  deals         CrmDeal[]
  tasks         CrmTask[]
  activities    CrmActivity[]
  notifications Notification[]
  commitments   OperationalCommitment[]
  createdMedia  CrmPropertyMedia[]
  studioBatches StudioBatch[]

  @@unique([companyAccountId, email])
  @@index([companyAccountId, active])
  @@index([companyAccountId, phoneNormalized])
  @@index([companyAccountId, availability, active])
}

model CrmContact {
  id                   String          @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  assignedMemberId     String?
  assignedMember       CompanyMember?  @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  name                 String
  phone                String?
  phoneNormalized      String?
  email                String?
  type                 CrmContactType  @default(BUYER)
  stage                CrmContactStage @default(NEW)
  source               String?
  desiredLocation      String?
  desiredRoomCount     String?
  budgetMin            Float?
  budgetMax            Float?
  notes                String?         @db.Text
  tags                 String[]        @default([])
  score                Int             @default(50)
  consentStatus        ConsentStatus   @default(UNKNOWN)
  consentUpdatedAt     DateTime?
  nextActionAt         DateTime?
  sourceConversationId String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  ownedProperties CrmProperty[] @relation("PropertyOwner")
  deals           CrmDeal[]
  tasks           CrmTask[]
  matches         CrmMatch[]
  activities      CrmActivity[]

  @@unique([companyAccountId, sourceConversationId])
  @@index([companyAccountId, stage])
  @@index([companyAccountId, phone])
  @@index([assignedMemberId])
}

model CrmProperty {
  id                  String            @id @default(cuid())
  companyAccountId    String
  companyAccount      CompanyAccount    @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  ownerContactId      String?
  ownerContact        CrmContact?       @relation("PropertyOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  assignedMemberId    String?
  assignedMember      CompanyMember?    @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  title               String
  referenceCode       String?
  location            String?
  price               Float?
  roomCount           String?
  area                Float?
  status              CrmPropertyStatus @default(DRAFT)
  description         String?           @db.Text
  imageUrl            String?
  sourceListingId     String?
  sellerPortalToken   String            @unique @default(uuid())
  sellerPortalEnabled Boolean           @default(true)
  listingViews        Int               @default(0)
  inquiryCount        Int               @default(0)
  showingCount        Int               @default(0)
  offerCount          Int               @default(0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  deals           CrmDeal[]
  tasks           CrmTask[]
  matches         CrmMatch[]
  activities      CrmActivity[]
  portfolioImport PortfolioImportItem?
  adCampaigns     AdCampaign[]
  media           CrmPropertyMedia[]
  studioBatches   StudioBatch[]

  @@unique([companyAccountId, sourceListingId])
  @@index([companyAccountId, status])
  @@index([ownerContactId])
  @@index([assignedMemberId])
}

model CrmPropertyMedia {
  id                String                 @id @default(cuid())
  companyAccountId  String
  companyAccount    CompanyAccount         @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  propertyId        String
  property          CrmProperty            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url               String                 @db.Text
  storageKey        String?
  fileName          String
  mimeType          String
  width             Int?
  height            Int?
  byteSize          Int?
  sortOrder         Int                    @default(0)
  isCover           Boolean                @default(false)
  mediaType         PropertyMediaType      @default(PHOTO)
  source            PropertyMediaSource    @default(MANUAL_UPLOAD)
  variantType       PropertyMediaVariant   @default(ORIGINAL)
  parentMediaId     String?
  parentMedia       CrmPropertyMedia?      @relation("PropertyMediaVariants", fields: [parentMediaId], references: [id], onDelete: SetNull)
  variants          CrmPropertyMedia[]     @relation("PropertyMediaVariants")
  prompt            String?                @db.Text
  aiProvider        String?
  aiModel           String?
  usageRightsStatus MediaUsageRightsStatus @default(CONFIRMED)
  fingerprint       String?
  provenance        Json?
  createdByMemberId String?
  createdByMember   CompanyMember?         @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  createdAt         DateTime               @default(now())
