  ownerPhoneNormalized             String?
  ownerPhoneVerificationStatus     PhoneVerificationStatus @default(UNVERIFIED)
  ownerPhoneVerifiedAt             DateTime?
  notifyCriticalImmediately        Boolean                 @default(true)
  notifyTaskAccepted               Boolean                 @default(false)
  notifyOnlyProblemsAndDelays      Boolean                 @default(true)
  alwaysNotifyHotLeads             Boolean                 @default(true)
  hourlySummaryEnabled             Boolean                 @default(false)
  morningSummaryEnabled            Boolean                 @default(true)
  eveningSummaryEnabled            Boolean                 @default(true)
  quietHoursEnabled                Boolean                 @default(true)
  quietHoursStart                  String                  @default("22:00")
  quietHoursEnd                    String                  @default("08:00")
