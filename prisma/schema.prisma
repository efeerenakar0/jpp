  createdAt         DateTime              @default(now())

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, occurredAt])
  @@index([outboxMessageId, occurredAt])
}

model WhatsAppDeliveryReceipt {
  id                String              @id @default(cuid())
  companyAccountId  String
  companyAccount    CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider          String
  providerMessageId String
  status            DeliveryAuditStatus
  rawStatus         String?
  errorCode         String?
  errorMessage      String?             @db.Text
  metadata          Json?
  idempotencyKey    String
