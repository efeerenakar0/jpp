  apiKeyHint            String
  apiKeyCreatedAt       DateTime                 @default(now())
  promptTemplate        String                   @db.Text
  status                String                   @default("PENDING")
  submittedAt           DateTime                 @default(now())
  deliveredAt           DateTime?
