}

model CalendarSyncLog {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  direction        String         @default("TWO_WAY")
  status           String
  pulledCount      Int            @default(0)
  pushedCount      Int            @default(0)
  conflictCount    Int            @default(0)
  errorMessage     String?        @db.Text
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  @@index([companyAccountId, startedAt])
}

model CrmMatch {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String
  contact          CrmContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String
  property         CrmProperty    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score            Int
  reasons          String[]       @default([])
  status           String         @default("NEW")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyAccountId, contactId, propertyId])
  @@index([companyAccountId, score])
}

model CrmActivity {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String?
  contact          CrmContact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         CrmProperty?   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  dealId           String?
  deal             CrmDeal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  actorMemberId    String?
  actorMember      CompanyMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)
  type             String
  title            String
  description      String?        @db.Text
  metadata         String?        @db.Text
  createdAt        DateTime       @default(now())

  @@index([companyAccountId, createdAt])
  @@index([contactId])
  @@index([propertyId])
  @@index([dealId])
}

model PlatformAdminLoginAttempt {
  id        String   @id @default(cuid())
  keyHash   String
  succeeded Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@index([createdAt])
}

// --- Modül 2: Avcı / Portföy Toplayıcı ---

model CompanyProfile {
  id              String   @id @default(cuid())
  companyName     String
  strengths       String[] // Şirketin güçlü yanları
  uniquePoints    String[] // Benzersiz satış noktaları (USP)
  targetAudience  String?  @db.Text
  serviceAreas    String[] // Hizmet bölgeleri
  yearsInBusiness Int?
  teamSize        Int?
  extraNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HuntedListing {
  id                       String                   @id @default(cuid())
  companyAccountId         String?
  companyAccount           CompanyAccount?          @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  huntJobId                String?
  huntJob                  HuntJob?                 @relation(fields: [huntJobId], references: [id], onDelete: SetNull)
  sourceProvider           SourceProvider?
  sourceListingId          String?
  sourceUrl                String                   @db.Text
  title                    String
  price                    String?
  location                 String?
  roomCount                String?
  area                     String?
  ownerName                String?
  ownerPhone               String?
  ownerPhoneNormalized     String?
  imageUrl                 String?
  rawData                  String?                  @db.Text
  descriptionText          String?                  @db.Text
  sanitizedDescriptionHtml String?                  @db.Text
  category                 String?
  subcategory              String?
  sellerType               String?
  listingPublishedAt       DateTime?
  priceAmount              Decimal?                 @db.Decimal(18, 2)
  currency                 String?
  province                 String?
  district                 String?
  neighborhood             String?
  street                   String?
  latitude                 Decimal?                 @db.Decimal(10, 7)
  longitude                Decimal?                 @db.Decimal(10, 7)
  addressPrecision         AddressPrecision         @default(UNKNOWN)
  acquisitionStatus        HuntingAcquisitionStatus @default(DISCOVERED)
  completenessScore        Int                      @default(0)
  attributesJson           Json?
  firstSeenAt              DateTime                 @default(now())
  lastSeenAt               DateTime                 @default(now())
  removedAt                DateTime?
  sourceUpdatedAt          DateTime?
  status                   HuntingStatus            @default(YELLOW)
  whatsappStatus           String                   @default("BEKLIYOR")
  notes                    String?                  @db.Text
  syncedToSite             Boolean                  @default(false)
  syncedProjectId          String?
  authorizationNote        String?                  @db.Text
  authorizedAt             DateTime?
  eliminationReason        String?
  eliminationNote          String?                  @db.Text
  eliminationSummary       String?                  @db.Text
  eliminatedAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  messages          HuntingMessage[]
  adCopies          AdCopy[]
  portfolioImport   PortfolioImportItem?
  images            HuntedListingImage[]
  contacts          HuntedContact[]
  policyDecisions   ContactPolicyDecision[]
  outreachApprovals HuntedOutreachApproval[]

  @@unique([companyAccountId, sourceUrl])
  @@unique([companyAccountId, sourceProvider, sourceListingId])
  @@index([companyAccountId, status, updatedAt])
  @@index([companyAccountId, acquisitionStatus, completenessScore])
  @@index([huntJobId, acquisitionStatus])
  @@index([sourceProvider, sourceListingId])
}

model SourceAuthorization {
  id                String                    @id @default(cuid())
  companyAccountId  String
  companyAccount    CompanyAccount            @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider          SourceProvider
  status            SourceAuthorizationStatus @default(PENDING)
  allowedScopes     SourceScope[]
  contractReference String
  startsAt          DateTime
  expiresAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  huntJobs HuntJob[]

  @@unique([companyAccountId, provider, contractReference])
  @@index([companyAccountId, provider, status, expiresAt])
}

model HuntJob {
  id                    String              @id @default(cuid())
  companyAccountId      String
  companyAccount        CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  sourceAuthorizationId String
  sourceAuthorization   SourceAuthorization @relation(fields: [sourceAuthorizationId], references: [id], onDelete: Restrict)
  provider              SourceProvider
  searchUrl             String              @db.Text
  idempotencyKey        String
  status                HuntJobStatus       @default(QUEUED)
  totalDiscovered       Int                 @default(0)
  totalCompleted        Int                 @default(0)
  totalPartial          Int                 @default(0)
  totalFailed           Int                 @default(0)
  errorSummary          String?             @db.Text
  createdBy             String
  startedAt             DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?
  lastHeartbeatAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  listings HuntedListing[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, createdAt])
  @@index([status, updatedAt])
}

model HuntedListingImage {
  id         String        @id @default(cuid())
  listingId  String
  listing    HuntedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order      Int
  sourceUrl  String        @db.Text
  storageKey String?
  checksum   String?
  mimeType   String?
  width      Int?
  height     Int?
  byteSize   Int?
  createdAt  DateTime      @default(now())

  @@unique([listingId, order])
  @@unique([listingId, sourceUrl])
  @@index([listingId, order])
}

model HuntedContact {
  id                   String                          @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount                  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId            String?
  listing              HuntedListing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  phoneCiphertext      String?                         @db.Text
  phoneHmac            String
  maskedPhone          String
  subjectRole          ContactSubjectRole              @default(UNKNOWN)
  sourceType           HuntedContactSourceType
  sourceReference      String
  purpose              String
  sourcePurposeAllowed Boolean?
  verificationStatus   HuntedContactVerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  verificationMethod   String?
  legalBasisStatus     ContactLegalBasisStatus         @default(UNKNOWN)
  retentionUntil       DateTime?
  quarantinedAt        DateTime?
  quarantineReason     String?
  doNotContactAt       DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  consents        ContactConsent[]
  policyDecisions ContactPolicyDecision[]
  approvals       HuntedOutreachApproval[]
  outboxMessages  WhatsAppOutboxMessage[]

  @@unique([companyAccountId, phoneHmac, listingId])
  @@index([companyAccountId, verificationStatus, doNotContactAt])
  @@index([listingId, sourceType])
}

model ContactConsent {
  id                      String                @id @default(cuid())
  contactId               String
  contact                 HuntedContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyAccountId        String
  companyAccount          CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  channel                 ContactConsentChannel
  purpose                 String
  status                  ContactConsentStatus  @default(UNKNOWN)
  consentTextVersion      String?
  evidenceReference       String?
  grantedAt               DateTime?
  revokedAt               DateTime?
  iysStatus               String?
  iysCheckedAt            DateTime?
  iysTransactionReference String?
  recipientType           String?
  recipientTypeEvidence   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([contactId, companyAccountId, channel, purpose])
  @@index([companyAccountId, channel, status])
}

model ContactPolicyDecision {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId        String
  listing          HuntedListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactId        String
  contact          HuntedContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          ContactConsentChannel
  purpose          String
  allowed          Boolean
  reasonCodes      String[]
  evaluatedAt      DateTime              @default(now())
  evaluatedBy      String

  @@index([companyAccountId, contactId, evaluatedAt])
  @@index([listingId, evaluatedAt])
}

model HuntedOutreachApproval {
  id               String                 @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount         @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId        String
  listing          HuntedListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactId        String
  contact          HuntedContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purpose          String
  channel          ContactConsentChannel
  status           OutreachApprovalStatus @default(APPROVED)
  approvedByType   String
  approvedById     String
  approvedAt       DateTime               @default(now())
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())

  @@index([companyAccountId, listingId, contactId, status])
  @@index([contactId, channel, purpose, approvedAt])
}

model PortfolioSource {
  id                  String         @id @default(cuid())
  companyAccountId    String
  companyAccount      CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  name                String
  type                String
  baseUrl             String?
  feedPath            String?
  encryptedCredential String?        @db.Text
  credentialHint      String?
  active              Boolean        @default(true)
  lastSyncStatus      String         @default("READY")
  lastSyncError       String?        @db.Text
  lastSyncedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  imports PortfolioImportItem[]

  @@index([companyAccountId, active])
  @@index([companyAccountId, lastSyncStatus])
}

model PortfolioImportItem {
  id               String           @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount   @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  sourceId         String?
  source           PortfolioSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  huntedListingId  String?          @unique
  huntedListing    HuntedListing?   @relation(fields: [huntedListingId], references: [id], onDelete: SetNull)
  propertyId       String?          @unique
  property         CrmProperty?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  externalId       String?
  fingerprint      String
  sourceUrl        String?
  title            String
  location         String?
  price            Float?
  roomCount        String?
  area             Float?
  description      String?          @db.Text
  imageUrl         String?
  rawPayload       String?          @db.Text
  status           String           @default("PENDING")
  reviewNote       String?          @db.Text
  reviewedBy       String?
  reviewedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([companyAccountId, fingerprint])
  @@index([companyAccountId, status, createdAt])
  @@index([sourceId, status])
}

model WhatsAppMessage {
  id                String          @id @default(cuid())
  companyAccountId  String?
  companyAccount    CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  phone             String
  fromMe            Boolean
  content           String          @db.Text
  status            String          @default("SENT") // QUEUED, SENT, DELIVERED, FAILED, DRAFT
  providerMessageId String?         @unique
  createdAt         DateTime        @default(now())

  @@index([companyAccountId, phone, createdAt])
}

model HuntingMessage {
  id        String        @id @default(cuid())
  listingId String
  listing   HuntedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  content   String        @db.Text // Üretilen ikna mesajı
  tone      String? // e.g. "resmi", "samimi", "acil"
  sent      Boolean       @default(false) // WhatsApp'tan gönderildi mi?
  createdAt DateTime      @default(now())
}

// --- Modül 1: Yazılımcı / Entegratör ---

model WebsiteTemplate {
  id          String   @id @default(cuid())
  name        String
  description String
  thumbnail   String // Önizleme görseli yolu
  category    String // e.g. "modern", "klasik", "minimal"
  htmlPath    String // Şablon dosya yolu
  createdAt   DateTime @default(now())

  generatedSites GeneratedWebsite[]
}

model GeneratedWebsite {
  id               String                 @id @default(cuid())
  companyAccountId String?
  companyAccount   CompanyAccount?        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  templateId       String?
  template         WebsiteTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  companyName      String
  logoUrl          String?
  primaryColor     String                 @default("#1a365d")
  accentColor      String                 @default("#c6a55a")
  phone            String?
  email            String?
  address          String?
  zipFilePath      String? // Üretilen .zip dosya yolu
  promptTemplate   String                 @db.Text
  status           String                 @default("pending") // pending, generating, ready, error
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  promptVersions   WebsitePromptVersion[]

  @@index([companyAccountId, createdAt])
}

model WebsiteIntegration {
  id                    String                      @id @default(cuid())
  companyAccountId      String
  companyAccount        CompanyAccount              @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  displayName           String
  websiteUrl            String
  websiteOrigin         String
  framework             String
  hostingProvider       String
  portfolioPath         String
  technicalContactEmail String
  repositoryUrl         String?
  notes                 String?                     @db.Text
  sourceBlobPathname    String
  sourceFileName        String
  sourceSize            Int
  apiKeyLookup          String                      @unique
  apiKeyHint            String
  apiKeyCreatedAt       DateTime                    @default(now())
  promptTemplate        String                      @db.Text
  status                WebsiteDeliveryStatus       @default(SUBMITTED)
  deliveryType          WebsiteDeliveryType?
  currentSourceVersion  Int                         @default(1)
  previewUrl            String?
  finalUrl              String?
  approvedAt            DateTime?
  approvedByAdminId     String?
  lastError             String?                     @db.Text
  submittedAt           DateTime                    @default(now())
  deliveredAt           DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  requestNonces         WebsiteRequestNonce[]
  rateLimitBuckets      WebsiteRateLimitBucket[]
  promptVersions        WebsitePromptVersion[]
  versions              WebsiteIntegrationVersion[]
  apiKeys               WebsiteIntegrationApiKey[]
  deliveryTokens        WebsiteDeliveryToken[]

  @@unique([companyAccountId, websiteOrigin])
  @@index([companyAccountId, status])
  @@index([status, createdAt])
}

model WebsiteIntegrationVersion {
  id                      String               @id @default(cuid())
  companyAccountId        String
  companyAccount          CompanyAccount       @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteIntegrationId    String
  websiteIntegration      WebsiteIntegration   @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  version                 Int
  sourceBlobPathname      String
  sourceFileName          String
  sourceSize              Int
  sourceSha256            String
  sourceSecurityReport    Json
  workOrderVersion        Int                  @default(1)
  workOrder               String               @db.Text
  resultBlobPathname      String?
  resultFileName          String?
  resultSize              Int?
  resultSha256            String?
  resultSecurityReport    Json?
  buildReport             Json?
  qaStatus                WebsiteQaStatus      @default(PENDING)
  qaReport                Json?
  previewUrl              String?
  finalUrl                String?
  deliveryType            WebsiteDeliveryType?
  submittedByType         String
  submittedById           String
  resultUploadedByAdminId String?
  approvedByAdminId       String?
  resultUploadedAt        DateTime?
  approvedAt              DateTime?
  deliveredAt             DateTime?
  retentionUntil          DateTime?
  lastError               String?              @db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  deliveryTokens WebsiteDeliveryToken[]

  @@unique([websiteIntegrationId, version])
  @@index([companyAccountId, createdAt])
  @@index([websiteIntegrationId, qaStatus, createdAt])
}

model WebsiteIntegrationApiKey {
  id                   String                   @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount           @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteIntegrationId String
  websiteIntegration   WebsiteIntegration       @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  environment          WebsiteApiKeyEnvironment
  status               WebsiteApiKeyStatus      @default(ACTIVE)
  keyLookup            String                   @unique
  keyHint              String
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  revokedAt            DateTime?
  createdByType        String
  createdById          String
  createdAt            DateTime                 @default(now())

  @@index([websiteIntegrationId, environment, status])
  @@index([companyAccountId, createdAt])
}

model WebsiteDeliveryToken {
  id                   String                    @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount            @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteIntegrationId String
  websiteIntegration   WebsiteIntegration        @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  versionId            String
  version              WebsiteIntegrationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tokenHash            String                    @unique
  tokenHint            String
  recipientEmail       String?
  expiresAt            DateTime
  usedAt               DateTime?
  createdByAdminId     String
  createdAt            DateTime                  @default(now())

  @@index([companyAccountId, expiresAt])
  @@index([websiteIntegrationId, versionId])
}

model WebsitePromptVersion {
  id                   String              @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteIntegrationId String?
  websiteIntegration   WebsiteIntegration? @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  generatedWebsiteId   String?
  generatedWebsite     GeneratedWebsite?   @relation(fields: [generatedWebsiteId], references: [id], onDelete: Cascade)
  version              Int
  promptTemplate       String              @db.Text
  source               String
  createdByType        String
  createdById          String
  sourceSnapshot       Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([websiteIntegrationId, version])
  @@unique([generatedWebsiteId, version])
  @@index([companyAccountId, createdAt])
}

model WebsiteRequestNonce {
  id                   String             @id @default(cuid())
  websiteIntegrationId String
  websiteIntegration   WebsiteIntegration @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  nonce                String
  expiresAt            DateTime
  createdAt            DateTime           @default(now())

  @@unique([websiteIntegrationId, nonce])
  @@index([expiresAt])
}

model WebsiteRateLimitBucket {
  id                   String             @id @default(cuid())
  websiteIntegrationId String
  websiteIntegration   WebsiteIntegration @relation(fields: [websiteIntegrationId], references: [id], onDelete: Cascade)
  bucketStart          DateTime
  requestCount         Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([websiteIntegrationId, bucketStart])
  @@index([bucketStart])
}

// --- Modül 3: Pazarlamacı / Reklam Ekibi ---

model AdCampaign {
  id                     String              @id @default(cuid())
  companyAccountId       String?
  companyAccount         CompanyAccount?     @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  propertyId             String?
  property               CrmProperty?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name                   String
  description            String?             @db.Text
  type                   String // "listing" veya "brand"
  objective              String?
  audience               String?
  tone                   String?
  status                 String              @default("DRAFT")
  publicationStatus      AdPublicationStatus @default(DRAFT)
  exportPackage          Json?
  exportedAt             DateTime?
  externalPublicationUrl String?
  publicationProofUrl    String?
  manuallyConfirmedAt    DateTime?
  manuallyConfirmedById  String?
  posterTemplate         String?
  posterHeadline         String?
  posterSubline          String?
  posterCta              String?
  generatedBy            String?
  generatedModel         String?
  internationalPlan      Json?
  isActive               Boolean             @default(true)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  adCopies AdCopy[]

  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, type])
  @@index([propertyId])
}

model AdCopy {
  id           String         @id @default(cuid())
  campaignId   String?
  campaign     AdCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  listingId    String?
  listing      HuntedListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  platform     AdPlatform
  headline     String
  body         String         @db.Text
  callToAction String?
  targetUrl    String? // İlan veya ana sayfa linki
  approved     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model MarketingWebsiteAnalysis {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  websiteUrl       String
  domain           String
  status           String         @default("READY")
  summary          String         @db.Text
  strengths        String         @db.Text
  opportunities    String         @db.Text
  channelPlan      String         @db.Text
  firstActions     String         @db.Text
  generatedBy      String
  generatedModel   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([companyAccountId, createdAt])
}

// --- Modül 4: Asistan / CRM ---

model CustomerConversation {
  id                    String              @id @default(cuid())
  companyAccountId      String?
  companyAccount        CompanyAccount?     @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  customerName          String
  customerPhone         String?
  customerEmail         String?
  channel               ConversationChannel @default(WEB_CHAT)
  intent                CustomerIntent      @default(UNKNOWN)
  summary               String?             @db.Text // AI tarafından üretilen özet
  notes                 String?             @db.Text
  tags                  String[]            @default([])
  aiEnabled             Boolean             @default(true)
  lastCustomerMessageAt DateTime?
  isActive              Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  messages            ConversationMessage[]
  appointmentRequests AppointmentRequest[]
  handoffs            ConversationHandoff[]
  viewingWorkflows    ViewingWorkflow[]

  @@index([companyAccountId, isActive, updatedAt])
  @@index([companyAccountId, customerPhone, channel])
}

model ConversationMessage {
  id                     String                @id @default(cuid())
  conversationId         String
  conversation           CustomerConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                   String // "customer", "assistant", "patron"
  content                String                @db.Text
  metadata               String?               @db.Text // JSON: çapraz satış önerileri vb.
  providerMessageId      String?               @unique
  deliveryStatus         MessageDeliveryStatus @default(NOT_APPLICABLE)
  messageType            String                @default("TEXT")
  deliveredAt            DateTime?
  readAt                 DateTime?
  failedAt               DateTime?
  errorMessage           String?               @db.Text
  processingStatus       String                @default("COMPLETED")
  processingStartedAt    DateTime?
  processingCompletedAt  DateTime?
  processingError        String?               @db.Text
  processingAttemptCount Int                   @default(0)
  createdAt              DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([deliveryStatus])
  @@index([processingStatus, createdAt])
}

model AppointmentRequest {
  id                              String               @id @default(cuid())
  companyAccountId                String
  companyAccount                  CompanyAccount       @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  conversationId                  String
  conversation                    CustomerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contactId                       String?
  contact                         CrmContact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  propertyId                      String?
  property                        CrmProperty?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedMemberId                String?
  assignedMember                  CompanyMember?       @relation("AppointmentAssignedMember", fields: [assignedMemberId], references: [id], onDelete: SetNull)
  taskId                          String?
  task                            CrmTask?             @relation(fields: [taskId], references: [id], onDelete: SetNull)
  dealId                          String?
  deal                            CrmDeal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  viewingWorkflowId               String?
  viewingWorkflow                 ViewingWorkflow?     @relation(fields: [viewingWorkflowId], references: [id], onDelete: SetNull)
  shortCode                       String?
  customerName                    String
  customerPhone                   String?
  proposedDate                    DateTime?
  proposedTime                    String?
  startAt                         DateTime?
  endAt                           DateTime?
  timezone                        String               @default("Europe/Istanbul")
  status                          AppointmentStatus    @default(PENDING)
  patronNote                      String?              @db.Text
  confirmMessage                  String?              @db.Text
  reminderSentAt                  DateTime?
  customerReminderSentAt          DateTime?
  employeeReminderSentAt          DateTime?
  employeeReminderCount           Int                  @default(0)
  employeeConfirmationDueAt       DateTime?
  employeeConfirmationEscalatedAt DateTime?
  employeeConfirmedAt             DateTime?
  employeeDeclinedAt              DateTime?
  outcomePromptSentAt             DateTime?
  outcomeReminderCount            Int                  @default(0)
  outcomeEscalatedAt              DateTime?
  rescheduledAt                   DateTime?
  cancelledAt                     DateTime?
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @updatedAt

  outcome            AppointmentOutcome?
  interactionPrompts WhatsAppInteractionPrompt[]

  @@unique([companyAccountId, shortCode])
  @@index([companyAccountId, status, startAt])
  @@index([status, proposedDate])
  @@index([assignedMemberId, startAt])
  @@index([viewingWorkflowId])
}

model ViewingWorkflow {
  id                          String                @id @default(cuid())
  companyAccountId            String
  companyAccount              CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId                   String
  contact                     CrmContact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  propertyId                  String
  property                    CrmProperty           @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  conversationId              String
  conversation                CustomerConversation  @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  crmTaskId                   String                @unique
  crmTask                     CrmTask               @relation(fields: [crmTaskId], references: [id], onDelete: Restrict)
  dealId                      String?
  deal                        CrmDeal?              @relation(fields: [dealId], references: [id], onDelete: SetNull)
  initialAppointmentRequestId String?
  shortCode                   String
  status                      ViewingWorkflowStatus @default(AWAITING_ASSIGNMENT_SEND)
  version                     Int                   @default(1)
  idempotencyKey              String
  startedAt                   DateTime              @default(now())
  completedAt                 DateTime?
  cancelledAt                 DateTime?
  lastError                   String?               @db.Text
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt

  assignmentAttempts  ViewingAssignmentAttempt[]
  interactionPrompts  WhatsAppInteractionPrompt[]
  appointmentRequests AppointmentRequest[]
  outcomes            AppointmentOutcome[]

  @@unique([companyAccountId, idempotencyKey])
  @@unique([companyAccountId, shortCode])
  @@index([companyAccountId, status, updatedAt])
  @@index([contactId, propertyId])
}

model ViewingAssignmentAttempt {
  id                        String                         @id @default(cuid())
  companyAccountId          String
  companyAccount            CompanyAccount                 @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  workflowId                String
  workflow                  ViewingWorkflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  taskId                    String
  propertyId                String
  contactId                 String
  memberId                  String
  member                    CompanyMember                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sequence                  Int
  previousAttemptId         String?
  outboxMessageId           String?                        @unique
  outboxMessage             WhatsAppOutboxMessage?         @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)
  providerMessageId         String?
  responseProviderMessageId String?
  status                    ViewingAssignmentAttemptStatus @default(AWAITING_SEND)
  sentAt                    DateTime?
  deliveredAt               DateTime?
  ackDeadlineAt             DateTime?
  answeredAt                DateTime?
  failureReason             String?                        @db.Text
  idempotencyKey            String
  createdAt                 DateTime                       @default(now())
  updatedAt                 DateTime                       @updatedAt

  interactionPrompts WhatsAppInteractionPrompt[]

  @@unique([workflowId, sequence])
  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, ackDeadlineAt])
  @@index([memberId, status])
}

model WhatsAppInteractionPrompt {
  id                         String                          @id @default(cuid())
  companyAccountId           String
  companyAccount             CompanyAccount                  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  workflowId                 String?
  workflow                   ViewingWorkflow?                @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  taskId                     String?
  propertyId                 String?
  contactId                  String?
  appointmentRequestId       String?
  appointmentRequest         AppointmentRequest?             @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  assignmentAttemptId        String?
  assignmentAttempt          ViewingAssignmentAttempt?       @relation(fields: [assignmentAttemptId], references: [id], onDelete: Cascade)
  actionId                   String?
  recipientType              WhatsAppPromptRecipientType
  recipientId                String
  recipientMemberId          String?
  recipientMember            CompanyMember?                  @relation("PromptRecipientMember", fields: [recipientMemberId], references: [id], onDelete: Cascade)
  promptType                 WhatsAppInteractionPromptType
  expectedResponseType       WhatsAppExpectedResponseType
  shortCode                  String
  candidateMemberSnapshot    Json?
  outboxMessageId            String?                         @unique
  outboxMessage              WhatsAppOutboxMessage?          @relation(fields: [outboxMessageId], references: [id], onDelete: SetNull)
  sentProviderMessageId      String?
  lastReplyProviderMessageId String?
  status                     WhatsAppInteractionPromptStatus @default(OPEN)
  deadlineAt                 DateTime?
  reminderCount              Int                             @default(0)
  lastReminderAt             DateTime?
  answeredAt                 DateTime?
  expiresAt                  DateTime?
  idempotencyKey             String
  createdAt                  DateTime                        @default(now())
  updatedAt                  DateTime                        @updatedAt

  @@unique([companyAccountId, idempotencyKey])
  @@unique([companyAccountId, lastReplyProviderMessageId])
  @@index([companyAccountId, recipientType, recipientId, status])
  @@index([recipientMemberId, status])
  @@index([companyAccountId, shortCode, status])
  @@index([assignmentAttemptId, status])
  @@index([sentProviderMessageId])
  @@index([deadlineAt, status])
}

model AppointmentOutcome {
  id                        String                   @id @default(cuid())
  companyAccountId          String
  companyAccount            CompanyAccount           @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  appointmentRequestId      String                   @unique
  appointmentRequest        AppointmentRequest       @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
  viewingWorkflowId         String?
  viewingWorkflow           ViewingWorkflow?         @relation(fields: [viewingWorkflowId], references: [id], onDelete: SetNull)
  reportedByMemberId        String?
  reportedByMember          CompanyMember?           @relation("AppointmentOutcomeReporter", fields: [reportedByMemberId], references: [id], onDelete: SetNull)
  outcome                   AppointmentOutcomeType
  noSaleReason              AppointmentNoSaleReason?
  reasonText                String?                  @db.Text
  nextAction                String?                  @db.Text
  nextActionAt              DateTime?
  followUpTaskId            String?
  followUpTask              CrmTask?                 @relation("AppointmentOutcomeFollowUpTask", fields: [followUpTaskId], references: [id], onDelete: SetNull)
  evidenceProviderMessageId String?
  saleDecision              SaleDecisionStatus?
  saleDecisionById          String?
  saleDecisionAt            DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([companyAccountId, outcome, createdAt])
  @@index([viewingWorkflowId])
}

// --- Ortak: Bildirim Sistemi ---

model Notification {
  id                String           @id @default(cuid())
  companyAccountId  String?
  companyAccount    CompanyAccount?  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  recipientMemberId String?
  recipientMember   CompanyMember?   @relation(fields: [recipientMemberId], references: [id], onDelete: Cascade)
  recipientKey      String?
  type              NotificationType
  title             String
  message           String           @db.Text
  link              String? // İlgili sayfaya yönlendirme linki
  important         Boolean          @default(false)
  read              Boolean          @default(false)
  dedupeKey         String?
  metadata          String?          @db.Text // JSON: ek bilgiler
  createdAt         DateTime         @default(now())

  @@unique([companyAccountId, recipientKey, dedupeKey])
  @@index([companyAccountId, recipientKey, important, read, createdAt])
}

// --- Modül 5: Dijital Fotoğraf Stüdyosu ---

model PhotoShoot {
  id             String   @id @default(cuid())
  device         String // e.g. "iPhone 15 Pro", "Samsung S Serisi"
  uploadedCount  Int      @default(0)
  uploadedPhotos String?  @db.Text // JSON: yüklenen orijinal fotoğrafların yolları
  status         String   @default("pending") // pending, processing, ready, error
  logoUrl        String?  @db.Text // Yüklenen PNG logo
  websiteUrl     String? // Eklenmek istenen web sitesi adresi
  textColor      String?  @default("#ffffff") // Web sitesi ve filigran yazı rengi
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  packages ProcessedPackage[]
}

model ProcessedPackage {
  id                String     @id @default(cuid())
  shootId           String
  shoot             PhotoShoot @relation(fields: [shootId], references: [id], onDelete: Cascade)
  filterName        String // e.g. "Ferah Gün Işığı"
  zipUrl            String // Orijinal Profesyonel HDR ZIP linki
  watermarkedZipUrl String? // Logo ve Web sitesi filigranlı ZIP linki
  createdAt         DateTime   @default(now())
}

// --- Komuta Merkezi (Genel Müdür Asistanı) ---

model GeneralManagerMessage {
  id                    String          @id @default(cuid())
  companyAccountId      String?
  companyAccount        CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  authorId              String?
  authorName            String?
  authorType            String?
  role                  String // "patron", "asistan", "system"
  content               String          @db.Text
  provider              String?
  clientRequestId       String?
  correlationId         String?
  processingStatus      String          @default("COMPLETED")
  processingStartedAt   DateTime?
  processingCompletedAt DateTime?
  processingError       String?         @db.Text
  structuredPlan        Json?
  processingProvider    String?
  processingModel       String?
  createdAt             DateTime        @default(now())

  @@unique([companyAccountId, clientRequestId])
  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, processingStatus, createdAt])
}

model PhoneVerificationChallenge {
  id               String         @id
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  subjectType      String
  subjectId        String
  phoneNormalized  String
  codeHash         String
  expiresAt        DateTime
  attempts         Int            @default(0)
  maxAttempts      Int            @default(5)
  sentAt           DateTime?
  consumedAt       DateTime?
  createdByType    String
  createdById      String?
  createdAt        DateTime       @default(now())

  @@index([companyAccountId, subjectType, subjectId, createdAt])
  @@index([companyAccountId, phoneNormalized, consumedAt, expiresAt])
}

model WhatsAppConfig {
  id                         String          @id @default(cuid())
  companyAccountId           String?         @unique
  companyAccount             CompanyAccount? @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  provider                   String          @default("EVOLUTION")
  token                      String?         @db.Text
  phoneNumberId              String?
  businessAccountId          String?
  verifyToken                String          @default("configure-in-environment")
  geminiApiKey               String?         @db.Text
  companyName                String?         @default("Business CEO AI")
  assistantName              String?         @default("Efe")
  serviceCity                String?         @default("Alanya")
  companyAddress             String?         @db.Text
  companyDetails             String?         @db.Text
  websiteUrl                 String?         @db.Text
  instagramUrl               String?         @db.Text
  languages                  String?         @db.Text
  fallbackTemplateName       String?
  templateLanguage           String?         @default("tr")
  evolutionInstanceName      String?         @unique
  evolutionInstanceId        String?
  evolutionWebhookSecretHash String?         @db.Text
  connectionStatus           String          @default("DISCONNECTED")
  connectedPhone             String?
  connectedProfileName       String?
  lastConnectedAt            DateTime?
  lastHealthCheckAt          DateTime?
  lastError                  String?         @db.Text
  platformEnabled            Boolean         @default(true)
  autoReplyEnabled           Boolean         @default(true)
  allowFirstContact          Boolean         @default(true)
  dailyMessageLimit          Int             @default(80)
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  @@index([connectionStatus, updatedAt])
}

model WhatsAppOutboxMessage {
  id                       String                @id @default(cuid())
  companyAccountId         String
  companyAccount           CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  conversationId           String?
  listingId                String?
  contactId                String?
  huntedContactId          String?
  huntedContact            HuntedContact?        @relation(fields: [huntedContactId], references: [id], onDelete: SetNull)
  propertyId               String?
  toPhone                  String
  content                  String                @db.Text
  provider                 String
  status                   String                @default("QUEUED")
  idempotencyKey           String
  providerMessageId        String?               @unique
  recipientType            WhatsAppRecipientType @default(UNKNOWN)
  recipientId              String?
  purpose                  String?
  relatedTaskId            String?
  operationEventId         String?
  operationEvent           OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId          String?
  managerAction            GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  correlationId            String?
  replyToProviderMessageId String?
  metadata                 Json?
  createdByType            String?
  createdById              String?
  attemptCount             Int                   @default(0)
  maxAttempts              Int                   @default(5)
  nextAttemptAt            DateTime              @default(now())
  lockedAt                 DateTime?
  sentAt                   DateTime?
  deliveredAt              DateTime?
  failedAt                 DateTime?
  lastError                String?               @db.Text
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  deliveryAudits           MessageDeliveryAudit[]
  viewingAssignmentAttempt ViewingAssignmentAttempt?
  interactionPrompt        WhatsAppInteractionPrompt?

  @@unique([companyAccountId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([companyAccountId, createdAt])
  @@index([companyAccountId, toPhone, createdAt])
  @@index([companyAccountId, recipientType, recipientId])
  @@index([companyAccountId, huntedContactId, createdAt])
  @@index([operationEventId])
  @@index([managerActionId])
}

// --- Dijital Genel Müdür: olay, aksiyon, kanıt ve gözlemlenebilirlik ---

model OperationEvent {
  id               String             @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount     @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  eventType        OperationEventType
  entityType       String?
  entityId         String?
  actorType        String?
  actorId          String?
  contactId        String?
  propertyId       String?
  listingId        String?
  taskId           String?
  conversationId   String?
  sourceProvider   String?
  sourceMessageId  String?
  metadata         Json?
  occurredAt       DateTime           @default(now())
  idempotencyKey   String
  createdAt        DateTime           @default(now())

  actions         GeneralManagerAction[]
  outboxMessages  WhatsAppOutboxMessage[]
  commitments     OperationalCommitment[]
  taskTransitions TaskStatusTransition[]
  auditLogs       ManagerAuditLog[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, eventType, occurredAt])
  @@index([companyAccountId, entityType, entityId])
  @@index([companyAccountId, sourceMessageId])
}

model GeneralManagerAction {
  id                    String                     @id @default(cuid())
  companyAccountId      String
  companyAccount        CompanyAccount             @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  operationEventId      String?
  operationEvent        OperationEvent?            @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  triggerMessageId      String?
  taskId                String?
  actionType            GeneralManagerActionType
  targetType            String?
  targetId              String?
  reason                String                     @db.Text
  evidence              Json?
  confidence            Float
  riskLevel             ManagerRiskLevel
  requiresApproval      Boolean                    @default(true)
  policyDecision        String
  payload               Json?
  proposedMessage       String?                    @db.Text
  status                GeneralManagerActionStatus @default(PROPOSED)
  idempotencyKey        String
  provider              String?
  model                 String?
  requestedByType       String?
  requestedById         String?
  errorCode             String?
  errorMessage          String?                    @db.Text
  approvedAt            DateTime?
  executionStartedAt    DateTime?
  executionAttemptCount Int                        @default(0)
  executedAt            DateTime?
  failedAt              DateTime?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  approval        ActionApproval?
  outboxMessages  WhatsAppOutboxMessage[]
  commitments     OperationalCommitment[]
  taskTransitions TaskStatusTransition[]
  handoffs        ConversationHandoff[]
  auditLogs       ManagerAuditLog[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, createdAt])
  @@index([companyAccountId, actionType, createdAt])
  @@index([operationEventId])
}

model ActionApproval {
  id               String                 @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount         @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  actionId         String                 @unique
  action           GeneralManagerAction   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  decision         ActionApprovalDecision @default(PENDING)
  decidedByType    String?
  decidedById      String?
  decisionReason   String?                @db.Text
  editedPayload    Json?
  decidedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([companyAccountId, decision, createdAt])
}

model TaskStatusTransition {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  taskId           String
  task             CrmTask               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromStatus       OperationalTaskStatus
  toStatus         OperationalTaskStatus
  operationEventId String?
  operationEvent   OperationEvent?       @relation(fields: [operationEventId], references: [id], onDelete: SetNull)
  managerActionId  String?
  managerAction    GeneralManagerAction? @relation(fields: [managerActionId], references: [id], onDelete: SetNull)
  sourceMessageId  String?
  actorType        String?
  actorId          String?
  evidence         Json?
  reason           String?               @db.Text
  idempotencyKey   String
  createdAt        DateTime              @default(now())

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, taskId, createdAt])
}

model OperationalCommitment {
