  updatedAt        DateTime              @updatedAt

  @@unique([companyAccountId, phoneNormalized, role, entityId])
  @@index([companyAccountId, phoneNormalized, active])
  @@index([companyAccountId, entityType, entityId])
}

model DailyManagerSummary {
