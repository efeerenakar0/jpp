  originalStorageKey String?
  originalFileName   String
  originalMimeType   String
  originalWidth      Int?
  originalHeight     Int?
  originalByteSize   Int?
  outputUrl          String?               @db.Text
  outputStorageKey   String?
  outputFileName     String?
  outputMimeType     String?
  outputWidth        Int?
  outputHeight       Int?
  outputByteSize     Int?
