  deliveryStatus   String         @default("NOT_REQUESTED")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([companyAccountId, periodStart, periodEnd])
  @@index([companyAccountId, periodStart])
}
