  status             StudioBatchItemStatus @default(PENDING)
  errorMessage       String?               @db.Text
  attachedMediaId    String?
  attachedMedia      CrmPropertyMedia?     @relation("StudioAttachedMedia", fields: [attachedMediaId], references: [id], onDelete: SetNull)
  fingerprint        String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([batchId, fingerprint])
  @@index([batchId, status, sortOrder])
  @@index([sourceMediaId])
  @@index([attachedMediaId])
}

model CrmDeal {
  id               String         @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  contactId        String
  contact          CrmContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         CrmProperty?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedMemberId String?
  assignedMember   CompanyMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
