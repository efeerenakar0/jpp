  allowedScopes     SourceScope[]
  contractReference String
  startsAt          DateTime
  expiresAt         DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  huntJobs HuntJob[]

  @@unique([companyAccountId, provider, contractReference])
  @@index([companyAccountId, provider, status, expiresAt])
}

model HuntJob {
  id                    String              @id @default(cuid())
  companyAccountId      String
  companyAccount        CompanyAccount      @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  sourceAuthorizationId String
  sourceAuthorization   SourceAuthorization @relation(fields: [sourceAuthorizationId], references: [id], onDelete: Restrict)
  provider              SourceProvider
  searchUrl             String              @db.Text
  idempotencyKey        String
  status                HuntJobStatus       @default(QUEUED)
  totalDiscovered       Int                 @default(0)
  totalCompleted        Int                 @default(0)
  totalPartial          Int                 @default(0)
  totalFailed           Int                 @default(0)
  errorSummary          String?             @db.Text
  createdBy             String
  startedAt             DateTime?
  pausedAt              DateTime?
  completedAt           DateTime?
  lastHeartbeatAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  listings HuntedListing[]

  @@unique([companyAccountId, idempotencyKey])
  @@index([companyAccountId, status, createdAt])
  @@index([status, updatedAt])
}

model HuntedListingImage {
  id         String        @id @default(cuid())
  listingId  String
  listing    HuntedListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  order      Int
  sourceUrl  String        @db.Text
  storageKey String?
  checksum   String?
  mimeType   String?
  width      Int?
  height     Int?
  byteSize   Int?
  createdAt  DateTime      @default(now())

  @@unique([listingId, order])
  @@unique([listingId, sourceUrl])
  @@index([listingId, order])
}

model HuntedContact {
  id                   String                          @id @default(cuid())
  companyAccountId     String
  companyAccount       CompanyAccount                  @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId            String?
  listing              HuntedListing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  phoneCiphertext      String?                         @db.Text
  phoneHmac            String
  maskedPhone          String
  subjectRole          ContactSubjectRole              @default(UNKNOWN)
  sourceType           HuntedContactSourceType
  sourceReference      String
  purpose              String
  sourcePurposeAllowed Boolean?
  verificationStatus   HuntedContactVerificationStatus @default(UNVERIFIED)
  verifiedAt           DateTime?
  verificationMethod   String?
  legalBasisStatus     ContactLegalBasisStatus         @default(UNKNOWN)
  retentionUntil       DateTime?
  quarantinedAt        DateTime?
  quarantineReason     String?
  doNotContactAt       DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  consents        ContactConsent[]
  policyDecisions ContactPolicyDecision[]
  approvals       HuntedOutreachApproval[]
  outboxMessages  WhatsAppOutboxMessage[]

  @@unique([companyAccountId, phoneHmac, listingId])
  @@index([companyAccountId, verificationStatus, doNotContactAt])
  @@index([listingId, sourceType])
}

model ContactConsent {
  id                      String                @id @default(cuid())
  contactId               String
  contact                 HuntedContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyAccountId        String
  companyAccount          CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  channel                 ContactConsentChannel
  purpose                 String
  status                  ContactConsentStatus  @default(UNKNOWN)
  consentTextVersion      String?
  evidenceReference       String?
  grantedAt               DateTime?
  revokedAt               DateTime?
  iysStatus               String?
  iysCheckedAt            DateTime?
  iysTransactionReference String?
  recipientType           String?
  recipientTypeEvidence   String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([contactId, companyAccountId, channel, purpose])
  @@index([companyAccountId, channel, status])
}

model ContactPolicyDecision {
  id               String                @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount        @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId        String
  listing          HuntedListing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactId        String
  contact          HuntedContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          ContactConsentChannel
  purpose          String
  allowed          Boolean
  reasonCodes      String[]
  evaluatedAt      DateTime              @default(now())
  evaluatedBy      String

  @@index([companyAccountId, contactId, evaluatedAt])
  @@index([listingId, evaluatedAt])
}

model HuntedOutreachApproval {
  id               String                 @id @default(cuid())
  companyAccountId String
  companyAccount   CompanyAccount         @relation(fields: [companyAccountId], references: [id], onDelete: Cascade)
  listingId        String
  listing          HuntedListing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  contactId        String
  contact          HuntedContact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  purpose          String
  channel          ContactConsentChannel
  status           OutreachApprovalStatus @default(APPROVED)
  approvedByType   String
  approvedById     String
  approvedAt       DateTime               @default(now())
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())

  @@index([companyAccountId, listingId, contactId, status])
  @@index([contactId, channel, purpose, approvedAt])
}

model PortfolioSource {
