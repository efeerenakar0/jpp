  messageQueuedAt      DateTime?
  deliveredAt          DateTime?
  acceptedAt           DateTime?
  startedAt            DateTime?
  lastStatusAt         DateTime?
  failedAt             DateTime?
  failureCode          String?
  failureReason        String?               @db.Text
  completedAt          DateTime?
