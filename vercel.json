{
  "buildCommand": "npm run vercel-build",
  "crons": [
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/digital-manager",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/studio-worker",
      "schedule": "* * * * *"
